# ---- copy to .env (never commit it) ----
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# development | production. Production refuses to start with mock payments,
# SQLite, http:// base URL or insecure cookies.
APP_ENV=development
# Public URL users type in the browser (used for payment redirects + e-mail links)
APP_BASE_URL=http://localhost:5173
HTTP_PORT=5173
CONTACT_EMAIL=support@your-domain.example

# ---- payments: mock | paymongo ----
PAYMENT_PROVIDER=mock
# PayMongo dashboard -> Developers -> API keys (sk_test_... / sk_live_...)
PAYMONGO_SECRET_KEY=
# PayMongo dashboard -> Webhooks: endpoint {APP_BASE_URL}/api/webhooks/paymongo,
# event checkout_session.payment.paid  -> copy its signing secret (whsk_...)
PAYMONGO_WEBHOOK_SECRET=

# ---- mail (password reset + receipts). Empty SMTP_HOST = log to console ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Gearhead FEA <no-reply@your-domain.example>

# ---- AI engineering assistant (workspace > "AI Assistant"). No key = the assistant is switched off ----
# Default LLM: Google Gemini. Key from https://aistudio.google.com/apikey. It stays on the server; the browser never sees it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
# gemini | anthropic | openrouter. Leave empty to use the first provider that has a key (Gemini, then Anthropic, then OpenRouter).
AGENT_PROVIDER=
# Alternative provider (AGENT_PROVIDER=anthropic): key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Last resort (used when no Gemini or Anthropic key is set): key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-pro
# Optional: AGENT_MODEL=claude-sonnet-5-5 (Anthropic only)  AGENT_MAX_TURNS=14  AGENT_REQUESTS_PER_MINUTE=12

# Optional overrides: COOKIE_SECURE (defaults true in production),
# FREE_MAX_PROJECTS=3, SESSION_DAYS=14, MAX_FAILED_LOGINS=5, LOCKOUT_MINUTES=15
