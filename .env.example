# ---- copy to .env (never commit it) ----
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# development | production. Production refuses to start with mock payments,
# SQLite, http:// base URL or insecure cookies.
APP_ENV=development
# Public URL users type in the browser (used for payment redirects + e-mail links)
APP_BASE_URL=http://localhost:5173
HTTP_PORT=5173
CONTACT_EMAIL=support@your-domain.example

# ---- payments: mock | paymongo ----
PAYMENT_PROVIDER=mock
# PayMongo dashboard -> Developers -> API keys (sk_test_... / sk_live_...)
PAYMONGO_SECRET_KEY=
# PayMongo dashboard -> Webhooks: endpoint {APP_BASE_URL}/api/webhooks/paymongo,
# event checkout_session.payment.paid  -> copy its signing secret (whsk_...)
PAYMONGO_WEBHOOK_SECRET=

# ---- mail (password reset + receipts). Empty SMTP_HOST = log to console ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Gearhead FEA <no-reply@your-domain.example>

# Optional overrides: COOKIE_SECURE (defaults true in production),
# FREE_MAX_PROJECTS=3, SESSION_DAYS=14, MAX_FAILED_LOGINS=5, LOCKOUT_MINUTES=15
